# Google Gemini API Key for card recognition
# Get your free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# TCGPlayer API Key (Optional - for real-time pricing)
# Get your API key from: https://developer.tcgplayer.com/
# If not provided, the app will use price estimation
TCGPLAYER_API_KEY=your_tcgplayer_api_key_here
